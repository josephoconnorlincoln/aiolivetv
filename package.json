{
  "name": "aiolivetv",
  "version": "0.6.2-beta",
  "description": "A unified Live TV hub for Stremio. Aggregate channels from multiple addons, EPG providers and M3U playlists into a single guide.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "test": "pnpm -r --if-present run test",
    "release": "commit-and-tag-version",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "metadata": "node scripts/generateMetadata.cjs",
    "gen:env-docs": "tsx scripts/gen-env-docs.ts",
    "build": "node scripts/generateMetadata.cjs && pnpm -F core run build && pnpm -F server run build && pnpm -F frontend run build",
    "dev": "pnpm -F core -F server -F frontend --parallel dev",
    "docs:build": "pnpm -F docs run build",
    "docs:dev": "pnpm -F docs run dev",
    "build:watch": "tsc --build --watch",
    "start": "node packages/server/dist/server",
    "start:addon": "pnpm run start",
    "start:dev": "cross-env NODE_ENV=development tsx watch packages/server/src/server.ts",
    "start:addon:dev": "pnpm run start:dev",
    "start:frontend:dev": "pnpm -F frontend run dev",
    "validate:live-tv": "pnpm -F core build && tsx scripts/validate-live-tv-e2e.ts"
  },
  "author": "mrcanelas",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "cross-env": "^7.0.3",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@11.0.8+sha512.4c4097e1dd2d42372c4e7fa5a791ff28fc75a484c7ac192e64b1df0fdef17594ba982f9b4fed9adfb3c757846f565b799b2763fb3733d1de1bcb82cf46684912",
  "engines": {
    "pnpm": ">=11.0.0",
    "node": ">=24.0.0"
  }
}
